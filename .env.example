# --- Postgres ---
POSTGRES_DB=polycloud
POSTGRES_USER=polycloud
POSTGRES_PASSWORD=polycloud
DATABASE_URL=postgres://polycloud:polycloud@postgres:5432/polycloud?sslmode=disable

# --- Backend ---
PORT=8080
LOG_LEVEL=info
# Kunci enkripsi token at-rest (AES-GCM). WAJIB diganti; minimal 16 karakter.
TOKEN_ENC_KEY=change-me-to-a-long-random-secret
# Halaman frontend yang menerima ?code&state dari provider OAuth.
OAUTH_REDIRECT_URL=http://127.0.0.1:3000/connect/callback
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Strategi smart routing: most-free | round-robin
ROUTING_STRATEGY=most-free

# --- Dashboard & API Authentication ---
# Set true untuk mewajibkan login dashboard & autentikasi request API (default: true)
AUTH_REQUIRED=true
# Kredensial default dashboard
ADMIN_EMAIL=admin@polycloud.local
ADMIN_PASSWORD=admin123
# Kunci signing token session HMAC (WAJIB diganti di production)
SESSION_SECRET=change-me-to-a-secure-session-secret-key

# --- rclone RC daemon (jangan pernah expose ke publik) ---
RCLONE_RC_URL=http://rclone:5572
RCLONE_RC_USER=polycloud
RCLONE_RC_PASS=change-me-rc-secret
# Folder fisik tempat semua objek ditaruh di tiap akun.
RCLONE_BASE_DIR=PolyCloud

# --- OAuth app platform (kosongkan kalau provider belum dipakai) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# --- Frontend ---
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
